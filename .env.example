# Development-only values. Never use these to connect to shared infrastructure.
INFODENGUE_PIPELINE_ENVIRONMENT=dev
INFODENGUE_PIPELINE_LOG_LEVEL=INFO
INFODENGUE_PIPELINE_DATABASE_URL=postgresql+psycopg://pipeline_dev:pipeline_dev_only@postgres:5432/pipeline_dev
INFODENGUE_PIPELINE_RABBITMQ_URL=amqp://pipeline_dev:pipeline_dev_only@rabbitmq:5672//
INFODENGUE_PIPELINE_MINIO_ENDPOINT=minio:9000
INFODENGUE_PIPELINE_MINIO_ACCESS_KEY=pipeline_dev
INFODENGUE_PIPELINE_MINIO_SECRET_KEY=pipeline_dev_only
INFODENGUE_PIPELINE_MINIO_SECURE=false
INFODENGUE_PIPELINE_MINIO_BUCKET=sinan-infodengue-dev
INFODENGUE_PIPELINE_REQUIRED_DISEASES=A90,A92.0
INFODENGUE_PIPELINE_INCOMING_ROOT=/var/lib/pipeline/incoming
INFODENGUE_PIPELINE_CANONICAL_ROOT=/var/lib/pipeline/canonical

POSTGRES_DB=pipeline_dev
POSTGRES_USER=pipeline_dev
POSTGRES_PASSWORD=pipeline_dev_only
RABBITMQ_DEFAULT_USER=pipeline_dev
RABBITMQ_DEFAULT_PASS=pipeline_dev_only
