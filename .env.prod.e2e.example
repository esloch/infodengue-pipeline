# Copy to .env.prod.e2e privately. The runner needs the same staging analysis
# connection as worker-analysis and a dedicated writer for its unique prefix.
INFODENGUE_PIPELINE_ANALYSIS_DATABASE_URL=postgresql+psycopg://replace-with-staging-scoped-role:replace-with-secret@staging-db-host:5432/staging-db-name
STAGING_E2E_MINIO_ACCESS_KEY=replace-with-dedicated-writer
STAGING_E2E_MINIO_SECRET_KEY=replace-with-dedicated-writer-secret
