INFODENGUE_PIPELINE_ENVIRONMENT=dev
INFODENGUE_PIPELINE_DATABASE_URL=postgresql+psycopg://pipeline_dev:pipeline_dev_only@pipeline-postgres:5432/pipeline_dev
INFODENGUE_PIPELINE_RABBITMQ_URL=amqp://pipeline_dev:pipeline_dev_only@pipeline-rabbitmq:5672//
INFODENGUE_PIPELINE_ALERTA_SOURCE_DATABASE_URL=postgresql+psycopg://pipeline_readonly:replace-with-dev-readonly-secret@postgres:5432/dengue
INFODENGUE_PIPELINE_BULLETIN_ENABLED=false
INFODENGUE_PIPELINE_BULLETIN_REFERENCE=/reference/recife_bairros.rds
INFODENGUE_PIPELINE_ANALYSIS_OUTPUT_ROOT=/var/lib/pipeline/analysis-output
INFODENGUE_PIPELINE_BULLETIN_OUTPUT_ROOT=/var/lib/pipeline/bulletins
