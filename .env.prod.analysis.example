# Copy to .env.prod.analysis, replace every placeholder, and never commit it.
# Only worker-analysis receives this file. The analysis role is read-only for load=false.
INFODENGUE_PIPELINE_ENVIRONMENT=prod
INFODENGUE_PIPELINE_LOG_LEVEL=INFO
INFODENGUE_PIPELINE_DATABASE_URL=postgresql+psycopg://pipeline_prod:replace-with-prod-profile-secret@pipeline-postgres:5432/pipeline_prod
INFODENGUE_PIPELINE_RABBITMQ_URL=amqp://pipeline_prod:replace-with-prod-profile-secret@pipeline-rabbitmq:5672//
INFODENGUE_PIPELINE_ANALYSIS_DATABASE_URL=postgresql+psycopg://pipeline_analysis_readonly:replace-with-analysis-readonly-secret@postgres:5432/alerta
INFODENGUE_PIPELINE_ANALYSIS_IMAGE=ghcr.io/esloch/infodengue-pipeline-analysis@sha256:replace-with-reviewed-digest
INFODENGUE_PIPELINE_ANALYSIS_OUTPUT_ROOT=/var/lib/pipeline/analysis-output
INFODENGUE_PIPELINE_ANALYSIS_CORES=1
INFODENGUE_PIPELINE_ANALYSIS_LOAD=false
INFODENGUE_PIPELINE_ANALYSIS_TIMEOUT_SECONDS=21600
INFODENGUE_PIPELINE_ANALYSIS_LOAD_LOCK_TIMEOUT_SECONDS=900
