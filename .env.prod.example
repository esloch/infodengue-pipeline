# Copy to .env.prod, replace every placeholder, and never commit the private file.
# The initial production profile is non-mutating: analysis_load remains false.
# For the staging-host rehearsal, point every external dependency to staging only.
PIPELINE_WORKER_ENV_FILE=../.env.prod
PIPELINE_ANALYSIS_ENV_FILE=../.env.prod.analysis
PIPELINE_POSTGRES_HOST_PORT=5436
PIPELINE_RABBITMQ_HOST_PORT=5675
PIPELINE_IMAGE=ghcr.io/esloch/infodengue-pipeline@sha256:replace-with-reviewed-digest
PIPELINE_ANALYSIS_IMAGE=ghcr.io/esloch/infodengue-pipeline-analysis@sha256:replace-with-reviewed-digest
PIPELINE_POSTGRES_PASSWORD=replace-with-prod-profile-secret
PIPELINE_RABBITMQ_PASSWORD=replace-with-prod-profile-secret
PIPELINE_ANALYSIS_E2E_DB_PASSWORD=replace-with-isolated-clone-admin-secret
PROD_INTEGRATION_NETWORK=replace-with-existing-integration-network
PROD_SINAN_INCOMING_HOST_PATH=/replace/with/shared/incoming
PROD_ANALYSIS_OUTPUT_HOST_PATH=/replace/with/analysis-output

INFODENGUE_PIPELINE_ENVIRONMENT=prod
INFODENGUE_PIPELINE_LOG_LEVEL=INFO
INFODENGUE_PIPELINE_DATABASE_URL=postgresql+psycopg://pipeline_prod:replace-with-prod-profile-secret@pipeline-postgres:5432/pipeline_prod
INFODENGUE_PIPELINE_RABBITMQ_URL=amqp://pipeline_prod:replace-with-prod-profile-secret@pipeline-rabbitmq:5672//
# Runtime MinIO account: read/list only for this bucket and prefix.
INFODENGUE_PIPELINE_MINIO_ENDPOINT=minio:9000
INFODENGUE_PIPELINE_MINIO_ACCESS_KEY=replace-with-runtime-service-account
INFODENGUE_PIPELINE_MINIO_SECRET_KEY=replace-with-runtime-service-secret
INFODENGUE_PIPELINE_MINIO_SECURE=false
INFODENGUE_PIPELINE_MINIO_BUCKET=replace-with-runtime-bucket
INFODENGUE_PIPELINE_MINIO_PREFIX=replace-with-runtime-prefix/
INFODENGUE_PIPELINE_INCOMING_ROOT=/var/lib/pipeline/incoming
# Read-only AlertaDengue ingestion.run inspection role; separate from analysis.
INFODENGUE_PIPELINE_ALERTA_SOURCE_DATABASE_URL=postgresql+psycopg://pipeline_readonly:replace-with-readonly-secret@postgres:5432/alerta
INFODENGUE_PIPELINE_ANALYSIS_IMAGE=ghcr.io/esloch/infodengue-pipeline-analysis@sha256:replace-with-reviewed-digest
INFODENGUE_PIPELINE_ANALYSIS_OUTPUT_ROOT=/var/lib/pipeline/analysis-output
INFODENGUE_PIPELINE_ANALYSIS_CORES=1
INFODENGUE_PIPELINE_ANALYSIS_LOAD=false
INFODENGUE_PIPELINE_ANALYSIS_TIMEOUT_SECONDS=21600
INFODENGUE_PIPELINE_ANALYSIS_LOAD_LOCK_TIMEOUT_SECONDS=900
INFODENGUE_PIPELINE_MINIO_POLL_SECONDS=60
INFODENGUE_PIPELINE_BRIDGE_POLL_SECONDS=30
INFODENGUE_PIPELINE_ANALYSIS_POLL_SECONDS=10
INFODENGUE_PIPELINE_ANALYSIS_DISPATCH_RETRY_SECONDS=60
INFODENGUE_PIPELINE_OUTBOX_POLL_SECONDS=15
