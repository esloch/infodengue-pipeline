# Development worker-only settings. Replace the DB URL only with a dev account.
INFODENGUE_PIPELINE_ENVIRONMENT=dev
INFODENGUE_PIPELINE_LOG_LEVEL=INFO
INFODENGUE_PIPELINE_DATABASE_URL=postgresql+psycopg://pipeline_dev:pipeline_dev_only@pipeline-postgres:5432/pipeline_dev
INFODENGUE_PIPELINE_RABBITMQ_URL=amqp://pipeline_dev:pipeline_dev_only@pipeline-rabbitmq:5672//
INFODENGUE_PIPELINE_ANALYSIS_DATABASE_URL=postgresql+psycopg://pipeline_readonly:pipeline_readonly_only@postgres:5432/alerta
INFODENGUE_PIPELINE_ANALYSIS_IMAGE=infodengue-pipeline-analysis:dev
INFODENGUE_PIPELINE_ANALYSIS_OUTPUT_ROOT=/var/lib/pipeline/analysis-output
INFODENGUE_PIPELINE_ANALYSIS_CORES=1
INFODENGUE_PIPELINE_ANALYSIS_LOAD=false
INFODENGUE_PIPELINE_ANALYSIS_TIMEOUT_SECONDS=21600
INFODENGUE_PIPELINE_ANALYSIS_LOAD_LOCK_TIMEOUT_SECONDS=900
