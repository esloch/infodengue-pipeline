ARG ALERTA_ANALYSIS_BASE_IMAGE
ARG ALERTA_ANALYSIS_REVISION=78114fbd497e3b447c942590361a860ea5fa241f

FROM ghcr.io/astral-sh/uv:0.11.14 AS uv

FROM python:3.11-slim-bookworm AS wheel-builder
COPY --from=uv /uv /uvx /usr/local/bin/

WORKDIR /build

COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src

RUN uv build --wheel --out-dir /dist \
    && uv export --frozen --no-dev --no-emit-project \
       --format requirements-txt --output-file /dist/requirements.txt


FROM ${ALERTA_ANALYSIS_BASE_IMAGE}

ARG ALERTA_ANALYSIS_REVISION
RUN test "${ALERTA_ANALYSIS_REVISION}" = \
      "78114fbd497e3b447c942590361a860ea5fa241f"
LABEL org.infodengue.alertadengueanalise.revision="${ALERTA_ANALYSIS_REVISION}"

# Fail the build if the actual base image still loads diseases separately.
RUN test -f /opt/alertadengueanalise/scripts/load_alertas.py \
    && grep -q -- '--single-transaction' \
      /opt/alertadengueanalise/scripts/load_alertas.py \
    && grep -q 'ON_ERROR_STOP=1' \
      /opt/alertadengueanalise/scripts/load_alertas.py \
    && grep -q 'scripts/load_alertas.py' \
      /opt/alertadengueanalise/.makim.yaml

COPY --from=wheel-builder /dist/ /tmp/pipeline-dist/

RUN python -m pip install --no-cache-dir \
      -r /tmp/pipeline-dist/requirements.txt \
    && python -m pip install --no-cache-dir --no-deps \
      /tmp/pipeline-dist/infodengue_pipeline-*.whl \
    && python -c 'import infodengue_pipeline' \
    && rm -r /tmp/pipeline-dist

WORKDIR /opt/alertadengueanalise
