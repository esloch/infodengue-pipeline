# Copy to .env.staging and replace every placeholder using staging secrets.
# This file contains placeholders only and must never be used for production.
PIPELINE_WORKER_ENV_FILE=../.env.staging.example
PIPELINE_ANALYSIS_ENV_FILE=../.env.staging.analysis.example
PIPELINE_IMAGE=infodengue-pipeline:staging
PIPELINE_ANALYSIS_IMAGE=infodengue-pipeline-analysis:staging
PIPELINE_POSTGRES_PASSWORD=replace-with-staging-secret
PIPELINE_RABBITMQ_PASSWORD=replace-with-staging-secret
STAGING_INTEGRATION_NETWORK=infodengue-staging_infodengue
STAGING_SINAN_INCOMING_HOST_PATH=/opt/data/staging/sinan/incoming
STAGING_ANALYSIS_OUTPUT_HOST_PATH=/opt/data/staging/analysis-output

INFODENGUE_PIPELINE_ENVIRONMENT=staging
INFODENGUE_PIPELINE_LOG_LEVEL=INFO
INFODENGUE_PIPELINE_DATABASE_URL=postgresql+psycopg://pipeline_staging:replace-with-staging-secret@pipeline-postgres:5432/pipeline_staging
INFODENGUE_PIPELINE_RABBITMQ_URL=amqp://pipeline_staging:replace-with-staging-secret@pipeline-rabbitmq:5672//
INFODENGUE_PIPELINE_MINIO_ENDPOINT=minio:9000
INFODENGUE_PIPELINE_MINIO_ACCESS_KEY=replace-with-dedicated-service-account
INFODENGUE_PIPELINE_MINIO_SECRET_KEY=replace-with-dedicated-service-secret
INFODENGUE_PIPELINE_MINIO_SECURE=false
INFODENGUE_PIPELINE_MINIO_BUCKET=sinan-infodengue
INFODENGUE_PIPELINE_MINIO_PREFIX=approved-fixtures/
INFODENGUE_PIPELINE_INCOMING_ROOT=/var/lib/pipeline/incoming
INFODENGUE_PIPELINE_ALERTA_SOURCE_DATABASE_URL=postgresql+psycopg://pipeline_readonly:replace-with-staging-readonly-secret@postgres:5432/alerta
INFODENGUE_PIPELINE_ANALYSIS_IMAGE=infodengue-pipeline-analysis:staging
INFODENGUE_PIPELINE_ANALYSIS_OUTPUT_ROOT=/var/lib/pipeline/analysis-output
INFODENGUE_PIPELINE_ANALYSIS_CORES=1
INFODENGUE_PIPELINE_ANALYSIS_LOAD=false
INFODENGUE_PIPELINE_ANALYSIS_TIMEOUT_SECONDS=21600
INFODENGUE_PIPELINE_ANALYSIS_LOAD_LOCK_TIMEOUT_SECONDS=900
INFODENGUE_PIPELINE_MINIO_POLL_SECONDS=60
INFODENGUE_PIPELINE_BRIDGE_POLL_SECONDS=30
INFODENGUE_PIPELINE_ANALYSIS_POLL_SECONDS=10
INFODENGUE_PIPELINE_ANALYSIS_DISPATCH_RETRY_SECONDS=60
INFODENGUE_PIPELINE_OUTBOX_POLL_SECONDS=15
